# Krisin Clothing Backend Configuration

# Neon PostgreSQL Database Connection String
# Get this from https://console.neon.tech -> Project Dashboard -> Connection Details
# Select "PostgreSQL" format:
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-your-project-id.us-east-2.aws.neon.tech/neondb?sslmode=require

# Razorpay API Keys (Dashboard -> Settings -> API Keys)
# The default test key works out of the box for client checkout testing
RAZORPAY_KEY_ID=rzp_test_1DP5mmOlF5G5ag
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Server Port
PORT=4000